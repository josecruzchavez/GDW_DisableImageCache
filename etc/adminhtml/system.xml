<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">

    <system>
        <section id="gdwcatalog">
            <group id="disableimagecache" translate="label" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Disable Image Cache</label>
                <resource>GDW_DisableImageCache::config</resource>

                <field id="disable_image_cache" translate="label" type="select" sortOrder="1"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Desactivar caché de imágenes</label>
                    <config_path>gdw/catalog_disableimagecache/disable_image_cache</config_path>
                    <comment>Si está en &quot;Sí&quot;, se devuelve siempre la imagen original sin ruta de caché (productos, categorías, CMS, etc.).</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
        </section>
    </system>
</config>
